 *@
@page
@model DeletePersonalDataModel

@{
    ViewData["Title"] = "Ta bort konto";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<section class="form-page">

    <div class="form-card">

        <div class="form-header">

            <span class="section-label">
                Konto
            </span>

            <h1>Ta bort konto</h1>

            <p>
                Här kan du permanent ta bort ditt konto från WeddingPlatform.
            </p>

        </div>

        <div class="alert alert-warning">

            <strong>Varning:</strong>

            Om du fortsätter kommer ditt konto och tillhörande data
            att tas bort permanent. Åtgärden kan inte ångras.

        </div>

        <form id="delete-user"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>

            @if (Model.RequirePassword)
            {
                <div class="form-group">

                    <label asp-for="Input.Password">
                        Bekräfta lösenord
                    </label>

                    <input asp-for="Input.Password"
                           class="form-control"
                           autocomplete="current-password" />

                    <span asp-validation-for="Input.Password"
                          class="field-validation">
                    </span>

                </div>
            }

            <button class="wedding-button"
                    style="background:#b34d4d;"
                    type="submit">
                Ta bort konto
            </button>

        </form>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}