 *@

@page
@model ChangePasswordModel

@{
    ViewData["Title"] = "Byt lösenord";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<section class="form-page">

    <div class="form-card">

        <div class="form-header">

            <span class="section-label">
                Konto
            </span>

            <h1>Byt lösenord</h1>

            <p>
                Uppdatera ditt lösenord för att hålla kontot säkert.
            </p>

        </div>

        <partial name="_StatusMessage"
                 for="StatusMessage" />

        <form id="change-password-form"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>

            <div class="form-group">

                <label asp-for="Input.OldPassword">
                    Nuvarande lösenord
                </label>

                <input asp-for="Input.OldPassword"
                       class="form-control"
                       autocomplete="current-password" />

                <span asp-validation-for="Input.OldPassword"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="Input.NewPassword">
                    Nytt lösenord
                </label>

                <input asp-for="Input.NewPassword"
                       class="form-control"
                       autocomplete="new-password" />

                <span asp-validation-for="Input.NewPassword"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="Input.ConfirmPassword">
                    Bekräfta nytt lösenord
                </label>

                <input asp-for="Input.ConfirmPassword"
                       class="form-control"
                       autocomplete="new-password" />

                <span asp-validation-for="Input.ConfirmPassword"
                      class="field-validation">
                </span>

            </div>

            <button type="submit"
                    class="wedding-button">
                Spara nytt lösenord
            </button>

        </form>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}